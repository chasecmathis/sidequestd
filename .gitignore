# Environment. Deny every .env* and re-admit the committed templates, so a new
# one (.env.production, say) is ignored by default rather than by remembering to
# come back here.
apps/api/.env
.env.*
!.env.example
!.env.*.example

# Node
node_modules/
dist/
out/
build/
.next/
.turbo/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Expo / React Native
.expo/
ios/
android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Editors / OS
.idea/
.vscode/
.DS_Store

# Claude Code
.claude/
