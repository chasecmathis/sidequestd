# Copy to .env for local development. Defaults already match infra/docker-compose.yml,
# so the file is only needed if you want to override something.

ENVIRONMENT=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://sidequestd:sidequestd@localhost:5432/sidequestd

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (no default is accepted) when ENVIRONMENT is staging or production —
# as are the CORS, cookie, SMTP and S3 settings below. The app refuses to start
# and lists every one it is still missing. See .context/architecture/deployment.md §1 for the full table.
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
MIN_PASSWORD_LENGTH=10

# Set REFRESH_COOKIE_SECURE=true (and samesite=none if the clients are on another
# domain) as soon as the API is served over HTTPS.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEB_APP_URL=http://localhost:3000

# The mobile client's URL scheme — `scheme` in apps/mobile/app.json. The Steam
# callback redirects a phone to sidequestd://settings/connections rather than to
# WEB_APP_URL, so the link finishes inside the app.
NATIVE_APP_SCHEME=sidequestd

# Mailpit — view everything sent at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
EMAIL_FROM=no-reply@sidequestd.app

# MinIO — avatars (SPEC §6.2) and review photos and clips (SPEC §6.3) land here
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=sidequestd-media
S3_ACCESS_KEY=sidequestd
S3_SECRET_KEY=sidequestd-secret
# Where uploads are *read* from. Unset means the bucket itself, which is what the
# local MinIO container serves. Point this at a CDN in production.
# S3_PUBLIC_URL_BASE=

# IGDB (SPEC §2). Leave unset: `npm run api:seed` imports the bundled fixture
# offline. Only needed for `npm run api:seed -- --igdb`.
# Register an app at https://api-docs.igdb.com/#account-creation
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=

# Steam account linking. Leave unset and the Connections section reports itself
# unavailable rather than offering a button that cannot work.
# Get a key at https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=
# Where this API is reachable from a browser. Steam redirects the member back
# here to finish linking, so it cannot be derived from the inbound request —
# behind a proxy that would be the internal address. Must be HTTPS in production.
#
# Loopback only works while every client is a browser on this machine. Steam
# redirects the *phone's* browser here, and `localhost` there is the phone — so
# testing the link from the mobile app means this machine's LAN address and
# `npm run api:lan`, exactly as reaching the API at all from a phone does. The
# symptom otherwise is a sign-in that ends on a localhost page with nothing on
# it, which looks like a broken feature and is this line.
API_PUBLIC_URL=http://localhost:8000

# Push notifications (SPEC §6.12). On by default and needs no credential: an
# Expo push token *is* the address, which is why `device_tokens` is guarded the
# way it is. Set an access token only once "enhanced security" is switched on
# for the Expo project. Turn the whole thing off to run without outbound HTTP.
# PUSH_ENABLED=true
# EXPO_ACCESS_TOKEN=

RATE_LIMIT_ENABLED=true
